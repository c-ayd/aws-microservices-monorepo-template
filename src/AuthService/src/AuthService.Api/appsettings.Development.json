{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "https://localhost:7000",
    "Audience": "https://localhost:8443",
    "AccessTokenLifespanInMinutes": 5,
    "RefreshTokenLifespanInDays": 2
  },
  "TokenLifespans": {
    "EmailVerificationLifespanInHours": 24,
    "ResetPasswordLifespanInMinutes": 60
  },
  "AccountLock": {
    "NumberOfFailedAttempsBeforeLock": 3,
    "LockTimeInMinutes": 5,
    "MaxLockTimeMultiplier": 3
  },
  "Encryption": {
    "DroppedMessagesKeyAlias": "alias/dropped-messages"
  },
  "Storage": {
    "DroppedMessagesBucketName": "template-dropped-messages"
  },
  "HttpsPort": 7000,
  "KnownCidrBlocks": [
    "0.0.0.0/0",
    "::/0"
  ],
  "AWS": {
    "ServiceURL": "http://localhost:4566",
    "Region": "us-east-1"
  }
}
