{
  "ReverseProxy": {
    "Routes": {
      "protected-service": {
        "ClusterId": "protected-cluster",
        "Match": {
          "Path": "/protected/{**catch-all}"
        },
        "AuthorizationPolicy": "Authenticated",
        "Transforms": [
          {
            "PathRemovePrefix": "/protected"
          }
        ]
      },
      "admin-service": {
        "ClusterId": "admin-cluster",
        "Match": {
          "Path": "/admin/{**catch-all}"
        },
        "AuthorizationPolicy": "AdminOnly",
        "Transforms": [
          {
            "PathRemovePrefix": "/admin"
          }
        ]
      }
    },
    "Clusters": {
      "protected-cluster": {
        "Destinations": {
          "protected-service": {
            "Address": "https://localhost:7001"
          }
        }
      },
      "admin-cluster": {
        "Destinations": {
          "admin-service": {
            "Address": "https://localhost:7002"
          }
        }
      }
    }
  }
}
