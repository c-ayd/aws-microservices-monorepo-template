{
  "AllowedHosts": "*",
  "Jwt": {
    "Authority": "https://auth-svc.internal:8443",
    "Audience": "https://api-gateway.internal:8443"
  },
  "CorsOrigins": {
    "AngularWeb": "https://mydomin.com"
  },
  "HttpsPort": 8443,
  "AWS": {
    "Region": "eu-central-1"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/auth"
          }
        ]
      },
      "admin-route": {
        "ClusterId": "admin-cluster",
        "Match": {
          "Path": "/admin/{**catch-all}"
        },
        "AuthorizationPolicy": "Admin",
        "Transforms": [
          {
            "PathRemovePrefix": "/admin"
          }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": {
            "Address": "https://auth-svc.internal:8443"
          }
        }
      },
      "admin-cluster": {
        "Destionations": {
          "admin-service": {
            "Address": "https://admin-svc.internal:8443"
          }
        }
      }
    }
  }
}
