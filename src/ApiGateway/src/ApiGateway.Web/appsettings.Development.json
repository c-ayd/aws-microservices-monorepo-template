{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Authority": "https://localhost:7000",
    "Audience": "https://localhost:8443"
  },
  "CorsOrigins": {
    "AngularWeb": "https://localhost:4200"
  },
  "HttpsPort": 8443,
  "AWS": {
    "ServiceURL": "http://localhost:4566",
    "Region": "us-east-1"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/auth"
          }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": {
            "Address": "https://localhost:7000"
          }
        }
      }
    }
  }
}
