{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Authority": "https://localhost:7000",
    "Audience": "https://localhost:8443"
  },
  "CorsOrigins": {
    "AngularWeb": "https://localhost:4200"
  },
  "Certificate": {
    "CABundlePath": "Certs/test-ca-bundle.crt",
    "ServerKeyFilePath": "Certs/test-api-gateway-server.key",
    "ServerCertificateFilePath": "Certs/test-api-gateway-server.crt"
  },
  "HttpsPort": 0,
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/auth"
          }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": {
            "Address": "https://localhost:7000"
          }
        }
      }
    }
  }
}
